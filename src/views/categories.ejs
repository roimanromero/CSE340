<%- include('partials/header') %>
<main class="container py-4">
    <h1><%= title %></h1>

    <!-- Botón para añadir una nueva categoría (Solo visible para administradores) -->
    <% if (user && user.role_name === 'admin') { %>
        <div class="mb-4" style="margin-bottom: 1.5rem;">
            <a href="/new-category" class="btn-primary" style="display: inline-block; text-decoration: none;">Add New Category</a>
        </div>
    <% } %>

    <% if (categories && categories.length > 0) { %>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No categories available at this time.</p>
    <% } %>
</main>
<%- include('partials/footer') %>